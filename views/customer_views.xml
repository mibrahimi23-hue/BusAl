<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_customer_tree" model="ir.ui.view">
    <field name="name">busal.customer.tree</field>
    <field name="model">busal.customer</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="email"/>
        <field name="phone"/>
        <field name="booking_count"/>
        <field name="total_spent"/>
      </tree>
    </field>
  </record>

  <record id="view_customer_form" model="ir.ui.view">
    <field name="name">busal.customer.form</field>
    <field name="model">busal.customer</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="first_name"/>
              <field name="last_name"/>
              <field name="email"/>
              <field name="phone"/>
            </group>
            <group>
              <field name="booking_count"/>
              <field name="total_spent"/>
            </group>
          </group>
          <notebook>
            <page string="Bookings">
              <field name="booking_ids" readonly="1">
                <tree>
                  <field name="booking_code"/>
                  <field name="route_id"/>
                  <field name="trip_date"/>
                  <field name="passenger_count"/>
                  <field name="total_amount"/>
                  <field name="status"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_customer" model="ir.actions.act_window">
    <field name="name">Passengers</field>
    <field name="res_model">busal.customer</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>