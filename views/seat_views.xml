<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_seat_tree" model="ir.ui.view">
    <field name="name">busal.seat.tree</field>
    <field name="model">busal.seat</field>
    <field name="arch" type="xml">
      <tree>
        <field name="bus_id"/>
        <field name="seat_number"/>
        <field name="seat_type"/>
        <field name="price"/>
      </tree>
    </field>
  </record>

  <record id="view_seat_form" model="ir.ui.view">
    <field name="name">busal.seat.form</field>
    <field name="model">busal.seat</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="bus_id"/>
            <field name="seat_number"/>
            <field name="seat_type"/>
            <field name="price"/>
            <field name="is_active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_seat" model="ir.actions.act_window">
    <field name="name">Seats</field>
    <field name="res_model">busal.seat</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>