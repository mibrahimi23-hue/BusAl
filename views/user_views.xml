<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_user_tree" model="ir.ui.view">
    <field name="name">Bus AL - User List</field>
    <field name="model">busal.user</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="email"/>
        <field name="phone"/>
        <field name="is_active"/>
      </tree>
    </field>
  </record>

  <record id="view_user_form" model="ir.ui.view">
    <field name="name">Bus AL - User Form</field>
    <field name="model">busal.user</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="email"/>
            <field name="password"/>
            <field name="phone"/>
            <field name="is_active"/>
            <field name="created_at"/>
            <field name="updated_at"/>
          </group>
          <separator string="Related"/>
          <field name="booking_ids"/>
          <field name="review_ids"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_user_search" model="ir.ui.view">
    <field name="name">Bus AL - User Search</field>
    <field name="model">busal.user</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="email"/>
        <field name="phone"/>
      </search>
    </field>
  </record>

  <record id="action_user" model="ir.actions.act_window">
    <field name="name">Users</field>
    <field name="res_model">busal.user</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Nuk ka përdorues të krijuar.</p>
    </field>
  </record>
</odoo>