<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_city_tree" model="ir.ui.view">
    <field name="name">busal.city.tree</field>
    <field name="model">busal.city</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="latitude"/>
        <field name="longitude"/>
      </tree>
    </field>
  </record>

  <record id="view_city_form" model="ir.ui.view">
    <field name="name">busal.city.form</field>
    <field name="model">busal.city</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="latitude"/>
            <field name="longitude"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_city" model="ir.actions.act_window">
    <field name="name">Cities</field>
    <field name="res_model">busal.city</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>