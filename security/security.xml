<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_busal" model="ir.module.category">
    <field name="name">BusAL</field>
  </record>

  <record id="group_busal_user" model="res.groups">
    <field name="name">BusAL User</field>
    <field name="category_id" ref="module_category_busal"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_busal_manager" model="res.groups">
    <field name="name">BusAL Manager</field>
    <field name="category_id" ref="module_category_busal"/>
    <field name="implied_ids" eval="[(4, ref('group_busal_user'))]"/>
    <field name="users" eval="[(4, ref('base.user_admin'))]"/>
  </record>

  <record id="rule_booking_own" model="ir.rule">
    <field name="name">BusAL booking: own records</field>
    <field name="model_id" ref="model_busal_booking"/>
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_busal_user'))]"/>
  </record>
  <record id="rule_booking_all" model="ir.rule">
    <field name="name">BusAL booking: manager sees all</field>
    <field name="model_id" ref="model_busal_booking"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_busal_manager'))]"/>
  </record>

  <record id="rule_ticket_own" model="ir.rule">
    <field name="name">BusAL ticket: own records</field>
    <field name="model_id" ref="model_busal_ticket"/>
    <field name="domain_force">[('booking_id.create_uid', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_busal_user'))]"/>
  </record>
  <record id="rule_ticket_all" model="ir.rule">
    <field name="name">BusAL ticket: manager sees all</field>
    <field name="model_id" ref="model_busal_ticket"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_busal_manager'))]"/>
  </record>

  <record id="rule_payment_own" model="ir.rule">
    <field name="name">BusAL payment: own records</field>
    <field name="model_id" ref="model_busal_payment"/>
    <field name="domain_force">[('booking_id.create_uid', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_busal_user'))]"/>
  </record>
  <record id="rule_payment_all" model="ir.rule">
    <field name="name">BusAL payment: manager sees all</field>
    <field name="model_id" ref="model_busal_payment"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_busal_manager'))]"/>
  </record>
</odoo>